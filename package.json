{
  "name": "motion-livre",
  "version": "0.0.0",
  "shortVersionWindows": "0.0.0.1",
  "description": "Editor de motion design aberto e offline para Windows",
  "main": "desktop/main.cjs",
  "author": "Motion Livre",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "check": "node --check app.js && node --check advanced.js && node --check desktop-integration.js && node --check pro-editor.js && node --check alight-compat.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node tools/validate-ui.cjs",
    "prepare:runtime": "powershell -ExecutionPolicy Bypass -File tools/prepare-runtime.ps1",
    "dist": "powershell -ExecutionPolicy Bypass -File tools/prepare-runtime.ps1 && electron-builder --projectDir ../motion-livre-runtime-staging --win nsis portable && powershell -ExecutionPolicy Bypass -File tools/clean-dist.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.motionlivre.editor",
    "productName": "Motion Livre",
    "buildNumber": "1",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "app": "../motion-livre-runtime-staging"
    },
    "files": [
      "index.html",
      "styles.css",
      "advanced.css",
      "export.css",
      "mixer.css",
      "pro-editor.css",
      "pro-mask.css",
      "media-fit.css",
      "app.js",
      "advanced.js",
      "pro-editor.js",
      "alight-compat.js",
      "desktop-integration.js",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {"from": "vendor/ffmpeg/ffmpeg.exe", "to": "ffmpeg/ffmpeg.exe"},
      {"from": "vendor/ffmpeg/ffprobe.exe", "to": "ffmpeg/ffprobe.exe"}
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Motion-Livre-0.0.0.1-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Motion-Livre-Setup-0.0.0.1-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Motion-Livre-Portable-0.0.0.1-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
