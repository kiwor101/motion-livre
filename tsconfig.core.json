{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src/core",
    "outDir": ".build/core"
  },
  "include": ["src/core/**/*.ts"]
}
